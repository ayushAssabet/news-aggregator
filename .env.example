ENV=production
LOG_LEVEL=INFO

# API
CORS_ORIGINS=https://your-frontend.example.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Database
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/appdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
AUTO_CREATE_TABLES=false

# Redis / Celery
REDIS_URL=redis://redis:6379/0

SCRAPE_SCHEDULE_SECONDS=360

# Summarization
GEMINI_API_KEY=
SUMMARY_MINUTE_LIMIT=15
SUMMARY_DAILY_LIMIT=200
SUMMARY_WAIT_ON_LIMIT=true


# Auth / JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_ISSUER=news-api
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080
